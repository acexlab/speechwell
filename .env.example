CHAT_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen2.5:30b
GRAMMAR_PROVIDER=ollama
GRAMMAR_OLLAMA_MODEL=qwen2.5:30b
WHISPER_MODEL=small.en
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SPEECHWELL_DATA_DIR=.
SPEECHWELL_STORAGE_DIR=storage
SQLITE_DB_PATH=speechwell.db

# Optional cloud providers (used when CHAT_PROVIDER is openai/gemini,
# or as fallback when CHAT_PROVIDER=auto and local Ollama is unavailable)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
